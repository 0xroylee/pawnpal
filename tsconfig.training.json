{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["training/**/*.ts", "src/**/*.ts"],
  "exclude": ["**/*.test.ts", "src/web/**/*.tsx"]
}
